+resize w/2 300 200
+show w/2
+wait
+move w/2 900 100
+wait
+assert_window_monitor_workspace w/2 secondary 0
+assert_focused w/2
+
+move_cursor_to 400 300
+create w/3 csd
+resize w/3 300 200
+show w/3
+wait
