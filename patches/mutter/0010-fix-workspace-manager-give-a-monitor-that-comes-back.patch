diff --git a/src/core/meta-workspace-manager.c b/src/core/meta-workspace-manager.c
index 6c1d077..296588b 100644
--- a/src/core/meta-workspace-manager.c
+++ b/src/core/meta-workspace-manager.c
@@ -114,6 +114,71 @@ free_workspace_container (gpointer data)
   g_free (container);
 }
 
+static void
+detach_workspace_container (MetaWorkspaceManager   *workspace_manager,
+                            MetaWorkspaceContainer *container)
+{
+  GList *l;
+
+  for (l = container->workspaces; l; l = l->next)
+    {
+      MetaWorkspace *workspace = l->data;
+
+      if (workspace->container == container)
+        {
+          workspace->container = NULL;
+          workspace->monitor = NULL;
+        }
+    }
+
+  container->monitor = NULL;
+  workspace_manager->detached_containers =
+    g_list_prepend (workspace_manager->detached_containers, container);
+}
+
+static MetaWorkspaceContainer *
+reattach_workspace_container (MetaWorkspaceManager *workspace_manager,
+                              MetaLogicalMonitor   *monitor,
+                              MetaMonitorSpec      *monitor_spec)
+{
+  GList *l;
+
+  if (!monitor_spec)
+    return NULL;
+
+  for (l = workspace_manager->detached_containers; l; l = l->next)
+    {
+      MetaWorkspaceContainer *container = l->data;
+      GList *wl;
+
+      if (!container->monitor_spec ||
+          !meta_monitor_spec_equals (container->monitor_spec, monitor_spec))
+        continue;
+
+      workspace_manager->detached_containers =
+        g_list_delete_link (workspace_manager->detached_containers, l);
+
+      if (!container->workspaces)
+        {
+          free_workspace_container (container);
+          return NULL;
+        }
+
+      container->monitor = monitor;
+      for (wl = container->workspaces; wl; wl = wl->next)
+        {
+          MetaWorkspace *workspace = wl->data;
+
+          workspace->container = container;
+          workspace->monitor = monitor;
+        }
+
+      return container;
+    }
+
+  return NULL;
+}
+
 static gboolean
 is_per_monitor_mode (MetaWorkspaceManager *workspace_manager)
 {
@@ -208,7 +273,20 @@ meta_workspace_manager_remove_from_container (MetaWorkspaceManager *workspace_ma
   MetaWorkspaceContainer *container = workspace->container;
 
   if (!container)
-    return;
+    {
+      GList *l;
+
+      for (l = workspace_manager->detached_containers; l; l = l->next)
+        {
+          MetaWorkspaceContainer *detached = l->data;
+
+          detached->workspaces = g_list_remove (detached->workspaces, workspace);
+          if (detached->active_workspace == workspace)
+            detached->active_workspace =
+              detached->workspaces ? detached->workspaces->data : NULL;
+        }
+      return;
+    }
 
   meta_topic (META_DEBUG_WORKSPACES,
               "Removing workspace %d from the container of monitor %p",
@@ -270,6 +348,8 @@ meta_workspace_manager_finalize (GObject *object)
   /* Cleanup per-monitor workspace states */
   if (workspace_manager->workspace_containers)
     g_hash_table_destroy (workspace_manager->workspace_containers);
+  g_list_free_full (g_steal_pointer (&workspace_manager->detached_containers),
+                    free_workspace_container);
 
   G_OBJECT_CLASS (meta_workspace_manager_parent_class)->finalize (object);
 }
@@ -612,7 +692,10 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
     meta_backend_get_monitor_manager (backend);
   GList *logical_monitors, *l;
   GHashTable *old_states;
+  GHashTableIter old_iter;
+  gpointer old_container;
   gboolean created_workspaces = FALSE;
+  gboolean reattached_workspaces = FALSE;
   int num_workspaces, i;
 
   if (!workspace_manager->per_monitor_workspaces)
@@ -688,6 +771,17 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
           for (GList *wl = container->workspaces; wl; wl = wl->next)
             ((MetaWorkspace *)wl->data)->monitor = monitor;
         }
+      else if ((container = reattach_workspace_container (workspace_manager,
+                                                          monitor,
+                                                          monitor_spec)))
+        {
+          reattached_workspaces = TRUE;
+          meta_topic (META_DEBUG_WORKSPACES,
+                      "Monitor %d (%s) got its %d workspaces back",
+                      meta_logical_monitor_get_number (monitor),
+                      container->monitor_spec->connector,
+                      g_list_length (container->workspaces));
+        }
       else
         {
           meta_topic (META_DEBUG_WORKSPACES,
@@ -711,8 +805,39 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
       g_hash_table_insert (workspace_manager->workspace_containers, monitor, container);
     }
 
+  g_hash_table_iter_init (&old_iter, old_states);
+  while (g_hash_table_iter_next (&old_iter, NULL, &old_container))
+    {
+      g_hash_table_iter_steal (&old_iter);
+      detach_workspace_container (workspace_manager, old_container);
+    }
+
   g_hash_table_destroy (old_states);
 
+  if (reattached_workspaces && !meta_prefs_get_dynamic_workspaces ())
+    update_num_workspaces_per_monitor (
+      workspace_manager,
+      meta_display_get_current_time_roundtrip (workspace_manager->display),
+      meta_prefs_get_num_workspaces ());
+
+  if (workspace_manager->active_workspace &&
+      !workspace_manager->active_workspace->container)
+    {
+      MetaLogicalMonitor *primary =
+        meta_monitor_manager_get_primary_logical_monitor (monitor_manager);
+      MetaWorkspaceContainer *primary_container =
+        g_hash_table_lookup (workspace_manager->workspace_containers, primary);
+
+      if (primary_container && primary_container->active_workspace)
+        {
+          workspace_manager->active_workspace =
+            primary_container->active_workspace;
+          g_signal_emit (workspace_manager,
+                         workspace_manager_signals[ACTIVE_WORKSPACE_CHANGED],
+                         0, NULL);
+        }
+    }
+
   /* Same as in the initial setup: workspaces created for monitors that just
    * appeared did not go through the usual add path.
    */
