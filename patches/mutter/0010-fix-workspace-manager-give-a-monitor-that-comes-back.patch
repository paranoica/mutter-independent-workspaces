+++ b/src/core/meta-workspace-manager-private.h
@@ -65,6 +65,7 @@ struct _MetaWorkspaceManager
   gboolean per_monitor_workspaces;
   /* MetaLogicalMonitor * -> MetaWorkspaceContainer * */
   GHashTable *workspace_containers;
+  GList *detached_containers;
 
