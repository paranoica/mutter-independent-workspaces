   if (window->workspace)
     meta_workspace_remove_window (window->workspace, window);
   else if (window->on_all_workspaces)
@@ -5447,6 +5479,8 @@ meta_window_change_workspace_without_transients (MetaWindow    *window,
   if (window->on_all_workspaces)
     return;
 
+  g_clear_weak_pointer (&window->evacuated_workspace);
+
   if (window->workspace == workspace)
     return;
 
