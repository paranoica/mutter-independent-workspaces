--- a/src/meta/meta-workspace-manager.h
+++ b/src/meta/meta-workspace-manager.h
@@ -88,5 +88,16 @@ META_EXPORT
 MetaWorkspace * meta_workspace_manager_get_active_workspace_for_monitor (MetaWorkspaceManager *workspace_manager,
                                                                          int                   monitor_index);
 
+META_EXPORT
+MetaWorkspace * meta_workspace_manager_append_new_workspace_for_monitor (MetaWorkspaceManager *workspace_manager,
+                                                                         int                   monitor_index,
+                                                                         gboolean              activate,
+                                                                         guint32               timestamp);
+
+META_EXPORT
+void meta_workspace_manager_reorder_workspace_on_monitor (MetaWorkspaceManager *workspace_manager,
+                                                          MetaWorkspace        *workspace,
+                                                          int                   new_index);
+
 META_EXPORT
 int meta_workspace_manager_get_layout_rows (MetaWorkspaceManager *workspace_manager);
diff --git a/src/x11/meta-x11-display.c b/src/x11/meta-x11-display.c
index 9fd4537..8ac37bd 100644
--- a/src/x11/meta-x11-display.c
+++ b/src/x11/meta-x11-display.c
@@ -1353,7 +1353,8 @@ meta_x11_display_new (MetaDisplay  *display,
 
   meta_x11_display_update_workspace_layout (x11_display);
 
-  if (meta_prefs_get_dynamic_workspaces ())
+  if (meta_prefs_get_dynamic_workspaces () &&
+      !meta_prefs_get_per_monitor_workspaces ())
     {
       int num = 0;
       int n_items = 0;
