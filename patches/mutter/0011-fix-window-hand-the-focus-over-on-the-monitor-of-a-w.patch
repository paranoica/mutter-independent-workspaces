From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paranoica <mitjumper@gmail.com>
Date: Tue, 24 Nov 2026 14:31:01 +0300
Subject: [PATCH] fix(window): hand the focus over on the monitor of a window
 that goes away

When a focused window was unmanaged or hidden, the focus went to the
default window of the global active workspace, which belongs to whichever
monitor last switched workspaces. Closing a focused window on one monitor
could so move the focus to a window on another one. wl-paste does this on
every paste, as it maps and destroys a window to read the clipboard.

Use the active workspace of the window's own monitor, as activation and
the MRU lookups already do.
---
 src/core/window.c                             |  8 +--
 src/tests/meson.build                         |  1 +
 ...monitor-workspaces-focus-fallback.metatest | 72 +++++++++++++++++++
 3 files changed, 77 insertions(+), 4 deletions(-)
 create mode 100644 src/tests/stacking/per-monitor-workspaces-focus-fallback.metatest

diff --git a/src/core/window.c b/src/core/window.c
index 9b27337..0372393 100644
--- a/src/core/window.c
+++ b/src/core/window.c
@@ -1693,7 +1693,7 @@ meta_window_unmanage (MetaWindow  *window,
       meta_topic (META_DEBUG_FOCUS,
                   "Focusing default window since we're unmanaging %s",
                   window->desc);
-      meta_workspace_focus_default_window (workspace_manager->active_workspace,
+      meta_workspace_focus_default_window (get_active_workspace_for_window (window),
                                            window,
                                            timestamp);
     }
@@ -2720,7 +2720,6 @@ meta_window_show (MetaWindow *window)
 static void
 meta_window_hide (MetaWindow *window)
 {
-  MetaWorkspaceManager *workspace_manager = window->display->workspace_manager;
   gboolean did_hide;
 
   meta_topic (META_DEBUG_WINDOW_STATE,
@@ -2782,6 +2781,7 @@ meta_window_hide (MetaWindow *window)
     {
       MetaWindow *not_this_one = NULL;
       MetaWorkspace *my_workspace = meta_window_get_workspace (window);
+      MetaWorkspace *active_workspace = get_active_workspace_for_window (window);
       guint32 timestamp = meta_display_get_current_time_roundtrip (window->display);
 
       /*
@@ -2794,11 +2794,11 @@ meta_window_hide (MetaWindow *window)
        * We also pass in NULL if we are in the process of hiding all non-desktop
        * windows to avoid unexpected changes to the stacking order.
        */
-      if (my_workspace == workspace_manager->active_workspace &&
+      if (my_workspace == active_workspace &&
           !my_workspace->showing_desktop)
         not_this_one = window;
 
-      meta_workspace_focus_default_window (workspace_manager->active_workspace,
+      meta_workspace_focus_default_window (active_workspace,
                                            not_this_one,
                                            timestamp);
     }
diff --git a/src/tests/meson.build b/src/tests/meson.build
index 9e7787b..f37f64d 100644
--- a/src/tests/meson.build
+++ b/src/tests/meson.build
@@ -1432,6 +1432,7 @@ endforeach
 per_monitor_stacking_tests = {
   'per-monitor-workspaces-dynamic': ['--dynamic-workspaces'],
   'per-monitor-workspaces-focus': [],
+  'per-monitor-workspaces-focus-fallback': [],
   'per-monitor-workspaces-new-window': [],
   'per-monitor-workspaces-reconnect': [],
   'per-monitor-workspaces-static': [],
diff --git a/src/tests/stacking/per-monitor-workspaces-focus-fallback.metatest b/src/tests/stacking/per-monitor-workspaces-focus-fallback.metatest
new file mode 100644
index 0000000..862932d
--- /dev/null
+++ b/src/tests/stacking/per-monitor-workspaces-focus-fallback.metatest
@@ -0,0 +1,72 @@
+resize_monitor default 800 600
+add_monitor secondary 800 600
+set_monitor_order default secondary
+assert_primary_monitor default
+set_pref center-new-windows false
+
+new_client w wayland
+
+move_cursor_to 400 300
+create w/1 csd
+resize w/1 300 200
+show w/1
+wait
+assert_window_monitor_workspace w/1 default 0
+
+move_cursor_to 1200 300
+create w/2 csd
+resize w/2 300 200
+show w/2
+wait
+assert_window_monitor_workspace w/2 secondary 0
+
+move_cursor_to 400 300
+activate_monitor_workspace default 1
+activate_monitor_workspace default 0
+assert_global_active_workspace default 0
+
+move_cursor_to 1200 300
+local_activate w/2
+wait
+assert_focused w/2
+assert_global_active_workspace default 0
+
+create w/3 csd
+resize w/3 300 200
+show w/3
+wait
+assert_window_monitor_workspace w/3 secondary 0
+assert_focused w/3
+destroy w/3
+wait
+assert_focused w/2
+
+create w/4 csd
+resize w/4 300 200
+show w/4
+wait
+assert_window_monitor_workspace w/4 secondary 0
+assert_focused w/4
+minimize w/4
+wait
+assert_focused w/2
+
+activate_monitor_workspace secondary 1
+activate_monitor_workspace secondary 0
+assert_global_active_workspace secondary 0
+
+move_cursor_to 400 300
+local_activate w/1
+wait
+assert_focused w/1
+assert_global_active_workspace secondary 0
+
+create w/5 csd
+resize w/5 300 200
+show w/5
+wait
+assert_window_monitor_workspace w/5 default 0
+assert_focused w/5
+destroy w/5
+wait
+assert_focused w/1
