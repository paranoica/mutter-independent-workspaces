From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paranoica <mitjumper@gmail.com>
Date: Tue, 24 Nov 2026 10:40:22 +0300
Subject: [PATCH] test(stacking): cover dynamic and static per-monitor
 workspace changes

Adds a --dynamic-workspaces option and commands to add, remove and reorder the workspaces of a monitor and to move a window to one of them.
---
 src/tests/meson.build                         |  13 +-
 .../per-monitor-workspaces-dynamic.metatest   |  39 ++++++
 .../per-monitor-workspaces-static.metatest    |  30 +++++
 src/tests/test-runner.c                       | 124 +++++++++++++++++-
 4 files changed, 197 insertions(+), 9 deletions(-)
 create mode 100644 src/tests/stacking/per-monitor-workspaces-dynamic.metatest
 create mode 100644 src/tests/stacking/per-monitor-workspaces-static.metatest

diff --git a/src/tests/meson.build b/src/tests/meson.build
index 279b9c7..502cbf0 100644
--- a/src/tests/meson.build
+++ b/src/tests/meson.build
@@ -1429,17 +1429,20 @@ foreach stacking_test: stacking_tests
   )
 endforeach
 
-per_monitor_stacking_tests = [
-  'per-monitor-workspaces-focus',
-  'per-monitor-workspaces-new-window',
-]
+per_monitor_stacking_tests = {
+  'per-monitor-workspaces-dynamic': ['--dynamic-workspaces'],
+  'per-monitor-workspaces-focus': [],
+  'per-monitor-workspaces-new-window': [],
+  'per-monitor-workspaces-static': [],
+}
 
-foreach stacking_test: per_monitor_stacking_tests
+foreach stacking_test, extra_args: per_monitor_stacking_tests
   test(stacking_test, test_runner,
     suite: ['core', 'mutter/stacking'],
     env: test_env,
     args: [
       '--per-monitor-workspaces',
+      extra_args,
       files('stacking' / stacking_test + '.metatest'),
     ],
     is_parallel: false,
diff --git a/src/tests/stacking/per-monitor-workspaces-dynamic.metatest b/src/tests/stacking/per-monitor-workspaces-dynamic.metatest
new file mode 100644
index 0000000..20644fe
--- /dev/null
+++ b/src/tests/stacking/per-monitor-workspaces-dynamic.metatest
@@ -0,0 +1,39 @@
+resize_monitor default 800 600
+add_monitor secondary 800 600
+set_monitor_order default secondary
+assert_primary_monitor default
+set_pref center-new-windows false
+
+assert_monitor_workspaces default 1
+assert_monitor_workspaces secondary 1
+
+append_monitor_workspace secondary
+append_monitor_workspace secondary
+assert_monitor_workspaces secondary 3
+assert_monitor_workspaces default 1
+
+new_client w wayland
+move_cursor_to 1200 300
+activate_monitor_workspace secondary 2
+create w/1 csd
+resize w/1 300 200
+show w/1
+wait
+assert_window_monitor_workspace w/1 secondary 2
+
+reorder_monitor_workspace secondary 2 0
+assert_window_monitor_workspace w/1 secondary 0
+assert_monitor_workspace_active secondary 0
+
+remove_monitor_workspace secondary 0
+assert_monitor_workspaces secondary 2
+assert_window_monitor_workspace w/1 secondary 0
+assert_monitor_workspace_active secondary 0
+assert_monitor_workspaces default 1
+
+remove_monitor_workspace default 0
+assert_monitor_workspaces default 1
+
+append_monitor_workspace default
+assert_monitor_workspaces default 2
+assert_monitor_workspaces secondary 2
diff --git a/src/tests/stacking/per-monitor-workspaces-static.metatest b/src/tests/stacking/per-monitor-workspaces-static.metatest
new file mode 100644
index 0000000..4b81649
--- /dev/null
+++ b/src/tests/stacking/per-monitor-workspaces-static.metatest
@@ -0,0 +1,30 @@
+resize_monitor default 800 600
+add_monitor secondary 800 600
+set_monitor_order default secondary
+assert_primary_monitor default
+set_pref center-new-windows false
+
+assert_monitor_workspaces default 4
+assert_monitor_workspaces secondary 4
+
+num_workspaces 2
+assert_monitor_workspaces default 2
+assert_monitor_workspaces secondary 2
+
+num_workspaces 3
+assert_monitor_workspaces default 3
+assert_monitor_workspaces secondary 3
+
+new_client w wayland
+move_cursor_to 400 300
+create w/1 csd
+resize w/1 300 200
+show w/1
+wait
+assert_window_main_monitor w/1 default
+assert_window_monitor_workspace w/1 default 0
+
+window_to_monitor_workspace w/1 secondary 1
+wait
+assert_window_main_monitor w/1 secondary
+assert_window_monitor_workspace w/1 secondary 1
diff --git a/src/tests/test-runner.c b/src/tests/test-runner.c
index 73f00be..8c70eba 100644
--- a/src/tests/test-runner.c
+++ b/src/tests/test-runner.c
@@ -1296,6 +1296,16 @@ parse_barrier_flags (const char        *flags_string,
   return TRUE;
 }
 
+static void
+wait_for_workspace_switch (TestCase *test)
+{
+  MetaDisplay *display = meta_context_get_display (test->context);
+
+  while (meta_compositor_is_switching_workspace (
+           meta_display_get_compositor (display)))
+    g_main_context_iteration (NULL, TRUE);
+}
+
 static MetaWorkspace *
 get_monitor_workspace (TestCase    *test,
                        const char  *monitor_id,
@@ -2900,10 +2910,108 @@ test_case_do (TestCase    *test,
 
       meta_workspace_activate (workspace,
                                meta_display_get_current_time_roundtrip (display));
+      wait_for_workspace_switch (test);
+    }
+  else if (strcmp (argv[0], "append_monitor_workspace") == 0)
+    {
+      MetaDisplay *display = meta_context_get_display (test->context);
+      MetaLogicalMonitor *logical_monitor;
+
+      if (argc != 2)
+        BAD_COMMAND ("usage: %s <monitor-id>", argv[0]);
+
+      logical_monitor = get_logical_monitor (test, argv[1], error);
+      if (!logical_monitor)
+        return FALSE;
+
+      if (!meta_workspace_manager_append_new_workspace_for_monitor (
+            meta_display_get_workspace_manager (display),
+            meta_logical_monitor_get_number (logical_monitor),
+            FALSE, meta_display_get_current_time_roundtrip (display)))
+        BAD_COMMAND ("Could not add a workspace to monitor %s", argv[1]);
+    }
+  else if (strcmp (argv[0], "remove_monitor_workspace") == 0)
+    {
+      MetaDisplay *display = meta_context_get_display (test->context);
+      MetaWorkspace *workspace;
+
+      if (argc != 3)
+        BAD_COMMAND ("usage: %s <monitor-id> <workspace-index>", argv[0]);
 
-      while (meta_compositor_is_switching_workspace (
-               meta_display_get_compositor (display)))
-        g_main_context_iteration (NULL, TRUE);
+      workspace = get_monitor_workspace (test, argv[1], argv[2], error);
+      if (!workspace)
+        return FALSE;
+
+      meta_workspace_manager_remove_workspace (
+        meta_display_get_workspace_manager (display), workspace,
+        meta_display_get_current_time_roundtrip (display));
+      wait_for_workspace_switch (test);
+    }
+  else if (strcmp (argv[0], "reorder_monitor_workspace") == 0)
+    {
+      MetaDisplay *display = meta_context_get_display (test->context);
+      MetaWorkspace *workspace;
+
+      if (argc != 4)
+        BAD_COMMAND ("usage: %s <monitor-id> <from-index> <to-index>", argv[0]);
+
+      workspace = get_monitor_workspace (test, argv[1], argv[2], error);
+      if (!workspace)
+        return FALSE;
+
+      meta_workspace_manager_reorder_workspace_on_monitor (
+        meta_display_get_workspace_manager (display), workspace, atoi (argv[3]));
+    }
+  else if (strcmp (argv[0], "window_to_monitor_workspace") == 0)
+    {
+      MetaTestClient *client;
+      const char *window_id;
+      MetaWindow *window;
+      MetaWorkspace *workspace;
+
+      if (argc != 4)
+        BAD_COMMAND ("usage: %s <window-id> <monitor-id> <workspace-index>",
+                     argv[0]);
+
+      if (!test_case_parse_window_id (test, argv[1], &client, &window_id, error))
+        return FALSE;
+
+      window = meta_test_client_find_window (client, window_id, error);
+      if (!window)
+        return FALSE;
+
+      workspace = get_monitor_workspace (test, argv[2], argv[3], error);
+      if (!workspace)
+        return FALSE;
+
+      meta_window_change_workspace (window, workspace);
+    }
+  else if (strcmp (argv[0], "assert_monitor_workspaces") == 0)
+    {
+      MetaDisplay *display = meta_context_get_display (test->context);
+      MetaLogicalMonitor *logical_monitor;
+      GList *workspaces;
+
+      if (argc != 3)
+        BAD_COMMAND ("usage: %s <monitor-id> <n-workspaces>", argv[0]);
+
+      logical_monitor = get_logical_monitor (test, argv[1], error);
+      if (!logical_monitor)
+        return FALSE;
+
+      workspaces = meta_workspace_manager_get_workspaces_for_monitor (
+        meta_display_get_workspace_manager (display),
+        meta_logical_monitor_get_number (logical_monitor));
+
+      if ((int) g_list_length (workspaces) != atoi (argv[2]))
+        {
+          g_set_error (error,
+                       META_TEST_CLIENT_ERROR,
+                       META_TEST_CLIENT_ERROR_ASSERTION_FAILED,
+                       "Monitor %s has %u workspaces, expected %s",
+                       argv[1], g_list_length (workspaces), argv[2]);
+          return FALSE;
+        }
     }
   else if (strcmp (argv[0], "assert_monitor_workspace_active") == 0)
     {
@@ -4004,6 +4112,7 @@ find_metatests_in_directory (GFile     *directory,
 
 static gboolean all_tests = FALSE;
 static gboolean per_monitor_workspaces = FALSE;
+static gboolean dynamic_workspaces = FALSE;
 
 const GOptionEntry options[] = {
   {
@@ -4018,6 +4127,12 @@ const GOptionEntry options[] = {
     "Run with per-monitor workspaces",
     NULL
   },
+  {
+    "dynamic-workspaces", 0, 0, G_OPTION_ARG_NONE,
+    &dynamic_workspaces,
+    "Run with dynamic workspaces",
+    NULL
+  },
   { NULL }
 };
 
@@ -4039,7 +4154,8 @@ main (int argc, char **argv)
     {
       g_autoptr (GSettings) mutter = g_settings_new ("org.gnome.mutter");
 
-      g_assert_true (g_settings_set_boolean (mutter, "dynamic-workspaces", FALSE));
+      g_assert_true (g_settings_set_boolean (mutter, "dynamic-workspaces",
+                                             dynamic_workspaces));
       g_assert_true (g_settings_set_boolean (mutter, "per-monitor-workspaces", TRUE));
     }
 
