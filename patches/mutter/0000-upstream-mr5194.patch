From 00a03b20d6a711476272d9a2a7ce3189fa27678e Mon Sep 17 00:00:00 2001
From: "Victor C." <34163765+vicajilau@users.noreply.github.com>
Date: Fri, 9 Oct 2026 07:56:59 +0200
Subject: [PATCH 17/23] workspace: Add explicit accessors for the two workspace
 indices

With per-monitor workspaces there are two positions a workspace has: where
it sits among every workspace that exists, and where it sits among the
workspaces of its own monitor. meta_workspace_index() answers whichever of
the two the workspace happens to have a container for, so the same call
means different things depending on a setting, and the caller cannot say
which one it wanted.

Add the two as separate functions so that callers have to pick:

  meta_workspace_get_global_index()      position among all workspaces
  meta_workspace_get_index_on_monitor()  position within its own monitor

The global one already existed as internal API for the compositor, which
needs to identify a workspace without a monitor to disambiguate it. Make it
public, since consumers outside mutter have the same need.

meta_workspace_index() keeps working as the monitor-relative variant while
its callers are moved over, and goes away afterwards.
---
 src/core/workspace-private.h |  1 -
 src/core/workspace.c         | 45 ++++++++++++++++++++++++++++--------
 src/meta/workspace.h         |  6 +++++
 3 files changed, 41 insertions(+), 11 deletions(-)

diff --git a/src/core/workspace-private.h b/src/core/workspace-private.h
index cd048fc2a04..237f3583139 100644
--- a/src/core/workspace-private.h
+++ b/src/core/workspace-private.h
@@ -80,7 +80,6 @@ struct _MetaWorkspaceClass
 };
 
 MetaWorkspace* meta_workspace_new           (MetaWorkspaceManager *workspace_manager);
-int            meta_workspace_get_global_index (MetaWorkspace *workspace);
 void           meta_workspace_remove        (MetaWorkspace *workspace);
 void           meta_workspace_add_window    (MetaWorkspace *workspace,
                                              MetaWindow    *window);
diff --git a/src/core/workspace.c b/src/core/workspace.c
index 9c046aafe5f..1eb571d7d18 100644
--- a/src/core/workspace.c
+++ b/src/core/workspace.c
@@ -908,10 +908,18 @@ meta_workspace_get_monitor_index (MetaWorkspace *workspace)
   return meta_logical_monitor_get_number (workspace->monitor);
 }
 
-/* The position of @workspace in the manager's list of every workspace. Unlike
- * meta_workspace_index(), this does not depend on which container the
- * workspace belongs to, which is what the index based compositor and plugin
- * API needs to be able to identify a workspace at all.
+/**
+ * meta_workspace_get_global_index:
+ * @workspace: a #MetaWorkspace
+ *
+ * Gets the position of @workspace among every workspace that exists, which is
+ * the index space of meta_workspace_manager_get_workspace_by_index() and of
+ * the workspace manager signals.
+ *
+ * This is the index to use whenever a workspace has to be identified on its
+ * own, without a monitor to disambiguate it.
+ *
+ * Returns: the position of @workspace in the global list, or -1
  */
 int
 meta_workspace_get_global_index (MetaWorkspace *workspace)
@@ -921,11 +929,32 @@ meta_workspace_get_global_index (MetaWorkspace *workspace)
   return g_list_index (workspace->manager->workspaces, workspace);
 }
 
+/* Transitional: callers are being moved to the explicit accessors above, and
+ * this goes away once none are left.
+ */
 int
 meta_workspace_index (MetaWorkspace *workspace)
+{
+  return meta_workspace_get_index_on_monitor (workspace);
+}
+
+/**
+ * meta_workspace_get_index_on_monitor:
+ * @workspace: a #MetaWorkspace
+ *
+ * Gets the position of @workspace among the workspaces shown on the same
+ * monitor, which is what the user sees as "the third workspace" on a monitor
+ * when per-monitor workspaces are enabled.
+ *
+ * Without per-monitor workspaces every workspace is shown on every monitor,
+ * so this is the same as meta_workspace_get_global_index().
+ *
+ * Returns: the position of @workspace within its own container, or -1
+ */
+int
+meta_workspace_get_index_on_monitor (MetaWorkspace *workspace)
 {
   GList *workspaces;
-  int ret;
 
   g_return_val_if_fail (META_IS_WORKSPACE (workspace), -1);
 
@@ -934,11 +963,7 @@ meta_workspace_index (MetaWorkspace *workspace)
   else
     workspaces = workspace->manager->workspaces;
 
-  ret = g_list_index (workspaces, workspace);
-
-  g_return_val_if_fail (ret >= 0, -1);
-
-  return ret;
+  return g_list_index (workspaces, workspace);
 }
 
 void
diff --git a/src/meta/workspace.h b/src/meta/workspace.h
index d81258e914c..196333ec7d6 100644
--- a/src/meta/workspace.h
+++ b/src/meta/workspace.h
@@ -38,6 +38,12 @@ GType meta_workspace_get_type (void);
 META_EXPORT
 int  meta_workspace_index (MetaWorkspace *workspace);
 
+META_EXPORT
+int  meta_workspace_get_global_index (MetaWorkspace *workspace);
+
+META_EXPORT
+int  meta_workspace_get_index_on_monitor (MetaWorkspace *workspace);
+
 META_EXPORT
 int  meta_workspace_get_monitor_index (MetaWorkspace *workspace);
 
-- 
