From efb72657480c6c3a421104241f5aed500430f1f6 Mon Sep 17 00:00:00 2001
From: "Victor C." <34163765+vicajilau@users.noreply.github.com>
Date: Fri, 21 Aug 2026 07:23:54 +0200
Subject: [PATCH 14/23] workspace-manager: Don't leave workspaces pointing at a
 freed container

When a monitor goes away, its container is dropped along with the old
hash table, but the workspaces it held stay in the manager's list. They
kept pointing at the container that was just freed, and
meta_workspace_index() reads the container's workspace list, so
unplugging one of two monitors produced one use after free per orphaned
workspace:

  libmutter-CRITICAL: meta_workspace_index: assertion 'ret >= 0' failed

Clear the back pointer of every workspace of a container being freed.
They are left without one, which meta_workspace_index() already handles
by falling back to the manager's list.

What should happen to the workspaces of a monitor that went away, and to
the windows on them, is a separate question this does not answer.
---
 src/core/meta-workspace-manager.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/src/core/meta-workspace-manager.c b/src/core/meta-workspace-manager.c
index aed5adff6d8..e4734d4141f 100644
--- a/src/core/meta-workspace-manager.c
+++ b/src/core/meta-workspace-manager.c
@@ -77,6 +77,18 @@ static void
 free_workspace_container (gpointer data)
 {
   MetaWorkspaceContainer *container = data;
+  GList *l;
+
+  /* The workspaces of a monitor that went away outlive their container, so
+   * make sure none of them is left pointing at it.
+   */
+  for (l = container->workspaces; l; l = l->next)
+    {
+      MetaWorkspace *workspace = l->data;
+
+      if (workspace->container == container)
+        workspace->container = NULL;
+    }
 
   g_list_free (container->workspaces);
   g_free (container);
-- 
