+/* Per-monitor workspaces API */
+
+/**
+ * meta_workspace_manager_get_workspaces_for_logical_monitor:
+ * @workspace_manager: A #MetaWorkspaceManager
+ * @monitor: The logical monitor
+ *
+ * Internal function: Returns the list of workspaces visible on the given monitor in per-monitor
+ * workspace mode. In classic (global) mode, returns NULL.
+ *
+ * Returns: (transfer none) (nullable): List of workspaces on the monitor, or NULL
+ */
+GList *
+meta_workspace_manager_get_workspaces_for_logical_monitor (MetaWorkspaceManager *workspace_manager,
+                                                           MetaLogicalMonitor   *monitor)
+{
+  MetaMonitorWorkspaceState *state;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+
+  if (!is_per_monitor_mode (workspace_manager))
+    return meta_workspace_manager_get_workspaces (workspace_manager);
+
+  g_return_val_if_fail (monitor != NULL, NULL);
+
+  state = g_hash_table_lookup (workspace_manager->monitor_workspace_states, monitor);
+  if (!state)
+    return NULL;
+
+  return state->workspaces;
+}
+
+/**
+ * meta_workspace_manager_get_active_workspace_for_logical_monitor:
+ * @workspace_manager: A #MetaWorkspaceManager
+ * @monitor: The logical monitor
+ *
+ * Internal function: Returns the currently active workspace on the given monitor in per-monitor
+ * workspace mode. In classic (global) mode, returns the global active workspace.
+ *
+ * Returns: (transfer none) (nullable): Active workspace on the monitor
+ */
+MetaWorkspace *
+meta_workspace_manager_get_active_workspace_for_logical_monitor (MetaWorkspaceManager *workspace_manager,
+                                                                 MetaLogicalMonitor   *monitor)
+{
+  MetaMonitorWorkspaceState *state;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+
+  if (!is_per_monitor_mode (workspace_manager))
+    return workspace_manager->active_workspace;
+
+  g_return_val_if_fail (monitor != NULL, NULL);
+
+  state = g_hash_table_lookup (workspace_manager->monitor_workspace_states, monitor);
+  if (!state)
+    return NULL;
+
+  return state->active_workspace;
+}
+
+/* Internal helper - gets monitor by index */
+static MetaLogicalMonitor *
+get_monitor_by_index (MetaWorkspaceManager *workspace_manager,
+                      int                   monitor_index)
+{
+  MetaBackend *backend;
+  MetaMonitorManager *monitor_manager;
+  GList *logical_monitors;
+
+  backend = meta_context_get_backend (meta_display_get_context (workspace_manager->display));
+  monitor_manager = meta_backend_get_monitor_manager (backend);
+  logical_monitors = meta_monitor_manager_get_logical_monitors (monitor_manager);
+
+  return g_list_nth_data (logical_monitors, monitor_index);
+}
+
+/**
+ * meta_workspace_manager_get_workspaces_for_monitor:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @monitor_index: index of the monitor
+ *
+ * Gets the list of workspaces associated with a specific monitor in per-monitor mode.
+ * In classic mode, returns all workspaces.
+ *
+ * Returns: (transfer none) (element-type MetaWorkspace): List of workspaces for the monitor
+ */
+GList *
+meta_workspace_manager_get_workspaces_for_monitor (MetaWorkspaceManager *workspace_manager,
+                                                   int                   monitor_index)
+{
+  MetaLogicalMonitor *monitor;
+  MetaMonitorWorkspaceState *state;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+
+  /* Classic mode: return all workspaces */
+  if (!workspace_manager->per_monitor_workspaces)
+    return workspace_manager->workspaces;
+
+  /* Per-monitor mode: return workspaces for specific monitor */
+  monitor = get_monitor_by_index (workspace_manager, monitor_index);
+  if (!monitor)
+    {
+      g_warning ("Invalid monitor index %d", monitor_index);
+      return NULL;
+    }
+
+  meta_topic (META_DEBUG_WORKSPACES,
+              "Looking up workspaces for monitor index %d (pointer=%p)",
+              monitor_index, monitor);
+
+  state = g_hash_table_lookup (workspace_manager->monitor_workspace_states,
+                               monitor);
+  if (!state)
+    {
+      g_warning ("No workspace state for monitor %d", monitor_index);
+      return NULL;
+    }
+
+  return state->workspaces;
+}
+
+/**
+ * meta_workspace_manager_get_active_workspace_for_monitor:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @monitor_index: index of the monitor
+ *
+ * Gets the currently active workspace on a specific monitor in per-monitor mode.
+ * In classic mode, returns the global active workspace.
+ *
+ * Returns: (transfer none): Active workspace for the monitor
+ */
+MetaWorkspace *
+meta_workspace_manager_get_active_workspace_for_monitor (MetaWorkspaceManager *workspace_manager,
+                                                         int                   monitor_index)
+{
+  MetaLogicalMonitor *monitor;
+  MetaMonitorWorkspaceState *state;
+
+  g_return_val_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager), NULL);
+
+  /* Classic mode: return global active workspace */
+  if (!workspace_manager->per_monitor_workspaces)
+    return workspace_manager->active_workspace;
+
+  /* Per-monitor mode: return active workspace for specific monitor */
+  monitor = get_monitor_by_index (workspace_manager, monitor_index);
+  if (!monitor)
+    {
+      g_warning ("Invalid monitor index %d", monitor_index);
+      return workspace_manager->active_workspace;  /* Fallback */
+    }
+
+  state = g_hash_table_lookup (workspace_manager->monitor_workspace_states,
+                               monitor);
+  if (!state)
+    {
+      g_warning ("No workspace state for monitor %d", monitor_index);
+      return workspace_manager->active_workspace;  /* Fallback */
+    }
+
+  return state->active_workspace;
+}
