+/* In per-monitor mode, a window belongs to the active workspace of the
+ * monitor it is on, rather than to the globally active one. Move it there
+ * whenever it is not already on a workspace visible on that monitor.
+ */
+static void
+update_active_workspace (MetaWindow *window)
+{
+  MetaWorkspaceManager *workspace_manager = window->display->workspace_manager;
+  MetaWorkspace *active_on_monitor;
+  int monitor_index;
+
+  if (!workspace_manager->per_monitor_workspaces || !window->monitor)
+    return;
+
+  /* A window on all workspaces is visible on every monitor already, and
+   * pinning it to one would drop that state.
+   */
+  if (window->on_all_workspaces)
+    return;
+
+  if (window->workspace &&
+      window->workspace->monitor == window->monitor)
+    return;
+
+  monitor_index = meta_logical_monitor_get_number (window->monitor);
+  active_on_monitor =
+    meta_workspace_manager_get_active_workspace_for_monitor (workspace_manager,
+                                                             monitor_index);
+
+  if (active_on_monitor && window->workspace != active_on_monitor)
+    set_workspace_state (window, FALSE, active_on_monitor);
+}
+
