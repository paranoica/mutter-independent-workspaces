+/**
+ * meta_workspace_manager_setup_per_monitor_workspaces:
+ * @workspace_manager: a #MetaWorkspaceManager
+ *
+ * Initialize per-monitor workspaces. Creates initial workspaces for each
+ * monitor when per-monitor-workspaces mode is enabled. Should be called
+ * after monitors are configured.
+ */
+void
+meta_workspace_manager_setup_per_monitor_workspaces (MetaWorkspaceManager *workspace_manager)
+{
+  MetaBackend *backend;
+  MetaMonitorManager *monitor_manager;
+  GList *logical_monitors, *l;
+  int num_workspaces;
+
+  g_return_if_fail (META_IS_WORKSPACE_MANAGER (workspace_manager));
+
+  if (!workspace_manager->per_monitor_workspaces)
+    return; /* Not in per-monitor mode */
+
+  MetaContext *context = meta_display_get_context (workspace_manager->display);
+  backend = meta_context_get_backend (context);
+  monitor_manager = meta_backend_get_monitor_manager (backend);
+  logical_monitors = meta_monitor_manager_get_logical_monitors (monitor_manager);
+
+  if (!logical_monitors)
+    return; /* No monitors yet */
+
+  meta_topic (META_DEBUG_WORKSPACES,
+              "Setting up per-monitor workspaces for %d monitors",
+              g_list_length (logical_monitors));
+
+  /* Per-monitor mode implies static workspaces */
+  num_workspaces = meta_prefs_get_num_workspaces ();
+
+  /* Clear any existing global workspaces created during init */
+  while (workspace_manager->workspaces)
+    {
+      MetaWorkspace *ws = workspace_manager->workspaces->data;
+      workspace_manager->workspaces = g_list_remove (workspace_manager->workspaces, ws);
+      g_object_unref (ws);
+    }
+
+  /* Create workspaces for each monitor */
+  for (l = logical_monitors; l; l = l->next)
+    {
+      MetaLogicalMonitor *monitor = l->data;
+      MetaMonitorWorkspaceState *state;
+      int monitor_number;
+      int i;
+
+      monitor_number = meta_logical_monitor_get_number (monitor);
+
+      meta_topic (META_DEBUG_WORKSPACES,
+                  "Creating workspaces for monitor %d (pointer=%p)",
+                  monitor_number, monitor);
+
+      state = g_new0 (MetaMonitorWorkspaceState, 1);
+      state->workspaces = NULL;
+      state->active_workspace = NULL;
+
+      /* Use monitor pointer as hash key to match lookup in internal APIs */
+      g_hash_table_insert (workspace_manager->monitor_workspace_states,
+                           monitor, state);
+
+      /* Create initial workspaces for this monitor */
+      for (i = 0; i < num_workspaces; i++)
+        {
+          MetaWorkspace *workspace = meta_workspace_new (workspace_manager);
+          workspace->monitor = monitor;
+          workspace->monitor_index = i;
+
+          /* Add to monitor's list (workspace already added to global pool by meta_workspace_new) */
+          state->workspaces = g_list_append (state->workspaces, workspace);
+
+          meta_topic (META_DEBUG_WORKSPACES,
+                      "Created workspace monitor_index=%d global_index=%d for monitor_num=%d (pointer=%p)",
+                      i, g_list_length (workspace_manager->workspaces) - 1,
+                      meta_logical_monitor_get_number (monitor), monitor);
+        }
+
+      /* Activate first workspace on each monitor */
+      if (state->workspaces)
+        {
+          state->active_workspace = state->workspaces->data;
+          meta_topic (META_DEBUG_WORKSPACES,
+                      "Activated workspace for monitor %d: monitor_index=%d, global_index=%d",
+                      meta_logical_monitor_get_number (monitor),
+                      state->active_workspace->monitor_index,
+                      g_list_length (workspace_manager->workspaces) - 1);
+        }
+    }
+
+  /* Set global active workspace to first monitor's first workspace */
+  if (logical_monitors)
+    {
+      MetaLogicalMonitor *first_monitor = logical_monitors->data;
+      MetaMonitorWorkspaceState *state =
+        g_hash_table_lookup (workspace_manager->monitor_workspace_states,
+                             first_monitor);
+
+      if (state && state->active_workspace)
+        {
+          workspace_manager->active_workspace = state->active_workspace;
+          meta_topic (META_DEBUG_WORKSPACES,
+                      "Set global active workspace to: monitor_index=%d, global_index=%d",
+                      state->active_workspace->monitor_index,
+                      meta_workspace_index (state->active_workspace));
+        }
+    }
+
+  meta_topic (META_DEBUG_WORKSPACES,
+              "Per-monitor workspaces setup complete with %d monitors",
+              g_list_length (logical_monitors));
+}
+
+/**
+ * on_monitors_changed:
+ * @monitor_manager: the monitor manager
+ * @workspace_manager: the workspace manager
+ *
+ * Signal handler called when monitor configuration changes.
+ * Sets up per-monitor workspaces if they haven't been initialized yet.
+ */
+static void
+on_monitors_changed (MetaMonitorManager   *monitor_manager,
+                     MetaWorkspaceManager *workspace_manager)
+{
+  GList *logical_monitors, *l;
+  GHashTable *old_states;
+  int num_workspaces, i;
+
+  if (!workspace_manager->per_monitor_workspaces)
+    return;
+
+  logical_monitors = meta_monitor_manager_get_logical_monitors (monitor_manager);
+  if (!logical_monitors)
+    {
+      meta_topic (META_DEBUG_WORKSPACES,
+                  "Monitors changed but no logical monitors available yet");
+      return;
+    }
+
+  /* Check if we need to initialize from scratch */
+  if (g_hash_table_size (workspace_manager->monitor_workspace_states) == 0)
+    {
+      meta_topic (META_DEBUG_WORKSPACES,
+                  "Monitors became available (%d monitors), setting up per-monitor workspaces",
+                  g_list_length (logical_monitors));
+      meta_workspace_manager_setup_per_monitor_workspaces (workspace_manager);
+      return;
+    }
+
+  /* Re-key monitor_workspace_states to new logical monitors and create states for new monitors */
+  old_states = workspace_manager->monitor_workspace_states;
+  workspace_manager->monitor_workspace_states =
+    g_hash_table_new_full (g_direct_hash,
+                           g_direct_equal,
+                           NULL,
+                           free_monitor_workspace_state);
+
+  num_workspaces = meta_prefs_get_num_workspaces ();
+
+  for (l = logical_monitors; l; l = l->next)
+    {
+      MetaLogicalMonitor *monitor = l->data;
+      MetaMonitorWorkspaceState *state = NULL;
+
+      /* Try to find matching state by logical monitor number */
+      GHashTableIter iter;
+      gpointer key, value;
+      g_hash_table_iter_init (&iter, old_states);
+      while (g_hash_table_iter_next (&iter, &key, &value))
+        {
+          MetaMonitorWorkspaceState *s = value;
+          if (s->monitor == monitor ||
+              (s->workspaces && ((MetaWorkspace *)s->workspaces->data)->monitor &&
+               meta_logical_monitor_get_number (((MetaWorkspace *)s->workspaces->data)->monitor) == meta_logical_monitor_get_number (monitor)))
+            {
+              state = s;
+              g_hash_table_iter_steal (&iter);
+              break;
+            }
+        }
+
+      if (state)
+        {
+          state->monitor = monitor;
+          for (GList *wl = state->workspaces; wl; wl = wl->next)
+            ((MetaWorkspace *)wl->data)->monitor = monitor;
+        }
+      else
+        {
+          state = g_new0 (MetaMonitorWorkspaceState, 1);
+          state->monitor = monitor;
+          for (i = 0; i < num_workspaces; i++)
+            {
+              MetaWorkspace *workspace = meta_workspace_new (workspace_manager);
+              workspace->monitor = monitor;
+              workspace->monitor_index = i;
+              state->workspaces = g_list_append (state->workspaces, workspace);
+            }
+          if (state->workspaces)
+            state->active_workspace = state->workspaces->data;
+        }
+
+      g_hash_table_insert (workspace_manager->monitor_workspace_states, monitor, state);
+    }
+
+  g_hash_table_destroy (old_states);
+}
+
