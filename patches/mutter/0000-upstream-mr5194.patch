+get_active_workspace_for_binding (MetaDisplay *display)
+{
+  MetaWorkspaceManager *workspace_manager = display->workspace_manager;
+
+  if (!workspace_manager->per_monitor_workspaces)
+    return workspace_manager->active_workspace;
+
+  return meta_workspace_manager_get_active_workspace_for_monitor (
+    workspace_manager, meta_display_get_current_monitor (display));
+}
+
+static MetaWorkspace *
+get_workspace_by_index_for_binding (MetaDisplay *display,
+                                    int          which)
+{
