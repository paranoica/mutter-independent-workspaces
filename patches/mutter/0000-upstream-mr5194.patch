From 897a4f0f4ab38e827c9b96e616f6ade17d56508a Mon Sep 17 00:00:00 2001
From: "Victor C." <34163765+vicajilau@users.noreply.github.com>
Date: Fri, 21 Aug 2026 08:19:44 +0200
Subject: [PATCH 16/23] workspace-manager: Identify a container's monitor by
 its spec

The containers were matched to the monitors of a new configuration by
comparing monitor numbers, but a number is a position in the list of
monitors, and it is reassigned when a monitor before it goes away.

Unplugging the middle of three monitors therefore renumbered the last
one onto the number of the one that went away, so it was handed that
monitor's container, while its own was freed and its workspaces left
belonging to nothing. A window on one of them stayed where it was, out
of every container, and so out of the workspace thumbnails too.

Match on the monitor spec instead, which names the connector, the vendor,
the product and the serial, and survives a reconfiguration. Keep a copy
of it in the container, so that recognising a monitor never depends on
the previous logical monitor still being around.

The report of what happened to a container now says which monitor it
belongs to rather than only the number it ended up with, since those
being different is exactly what went wrong here.
---
 src/core/meta-workspace-manager-private.h |  4 ++
 src/core/meta-workspace-manager.c         | 51 +++++++++++++++++------
 2 files changed, 43 insertions(+), 12 deletions(-)

diff --git a/src/core/meta-workspace-manager-private.h b/src/core/meta-workspace-manager-private.h
index 51140d35b3c..52ca8884880 100644
--- a/src/core/meta-workspace-manager-private.h
+++ b/src/core/meta-workspace-manager-private.h
@@ -44,6 +44,10 @@
 typedef struct _MetaWorkspaceContainer
 {
   MetaLogicalMonitor *monitor;
+  /* The monitor is replaced by a new object whenever the monitors change, and
+     its number is reassigned when another monitor goes away, so keep what does
+     identify it across a reconfiguration */
+  MetaMonitorSpec *monitor_spec;
   GList *workspaces;
   MetaWorkspace *active_workspace;
 } MetaWorkspaceContainer;
diff --git a/src/core/meta-workspace-manager.c b/src/core/meta-workspace-manager.c
index 9810d182d6c..94f390a17f2 100644
--- a/src/core/meta-workspace-manager.c
+++ b/src/core/meta-workspace-manager.c
@@ -30,6 +30,8 @@
 
 #include "backends/meta-backend-private.h"
 #include "backends/meta-monitor-manager-private.h"
+#include "backends/meta-logical-monitor-private.h"
+#include "backends/meta-monitor-private.h"
 #include "core/display-private.h"
 #include "core/window-private.h"
 #include "core/workspace-private.h"
@@ -71,6 +73,22 @@ static void prefs_changed_callback (MetaPreference pref,
 
 static void meta_workspace_manager_init_workspaces (MetaWorkspaceManager *workspace_manager);
 
+/* What identifies the monitor a container belongs to across a
+ * reconfiguration. A logical monitor is made of one or more monitors, and no
+ * two logical monitors share one, so the first is enough to tell them apart.
+ */
+static MetaMonitorSpec *
+monitor_spec_for_logical_monitor (MetaLogicalMonitor *logical_monitor)
+{
+  GList *monitors;
+
+  monitors = meta_logical_monitor_get_monitors (logical_monitor);
+  if (!monitors)
+    return NULL;
+
+  return meta_monitor_get_spec (monitors->data);
+}
+
 static void
 free_workspace_container (gpointer data)
 {
@@ -88,6 +106,7 @@ free_workspace_container (gpointer data)
         workspace->container = NULL;
     }
 
+  g_clear_pointer (&container->monitor_spec, meta_monitor_spec_free);
   g_list_free (container->workspaces);
   g_free (container);
 }
@@ -323,7 +342,6 @@ meta_workspace_manager_new (MetaDisplay *display)
                                g_direct_equal,
                                NULL,
                                free_workspace_container);
-
     }
 
   /* This is the default layout extracted from default
@@ -431,6 +449,7 @@ meta_workspace_manager_setup_per_monitor_workspaces (MetaWorkspaceManager *works
     {
       MetaLogicalMonitor *monitor = l->data;
       MetaWorkspaceContainer *container;
+      MetaMonitorSpec *monitor_spec;
       int monitor_number;
       int i;
 
@@ -442,6 +461,9 @@ meta_workspace_manager_setup_per_monitor_workspaces (MetaWorkspaceManager *works
 
       container = g_new0 (MetaWorkspaceContainer, 1);
       container->monitor = monitor;
+      monitor_spec = monitor_spec_for_logical_monitor (monitor);
+      container->monitor_spec =
+        monitor_spec ? meta_monitor_spec_clone (monitor_spec) : NULL;
 
       /* Use monitor pointer as hash key to match lookup in internal APIs */
       g_hash_table_insert (workspace_manager->workspace_containers,
@@ -573,19 +595,18 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
     {
       MetaLogicalMonitor *monitor = l->data;
       MetaWorkspaceContainer *container = NULL;
-
-      /* Try to find matching container by logical monitor number */
+      MetaMonitorSpec *monitor_spec;
       GHashTableIter iter;
       gpointer key, value;
+
+      monitor_spec = monitor_spec_for_logical_monitor (monitor);
       g_hash_table_iter_init (&iter, old_states);
       while (g_hash_table_iter_next (&iter, &key, &value))
         {
           MetaWorkspaceContainer *s = value;
 
-          if (s->monitor == monitor ||
-              (s->monitor &&
-               meta_logical_monitor_get_number (s->monitor) ==
-               meta_logical_monitor_get_number (monitor)))
+          if (s->monitor_spec && monitor_spec &&
+              meta_monitor_spec_equals (s->monitor_spec, monitor_spec))
             {
               container = s;
               g_hash_table_iter_steal (&iter);
@@ -596,9 +617,11 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
       if (container)
         {
           meta_topic (META_DEBUG_WORKSPACES,
-                      "Kept the %d workspaces of monitor %d",
-                      g_list_length (container->workspaces),
-                      meta_logical_monitor_get_number (monitor));
+                      "Monitor %d (%s) kept its %d workspaces",
+                      meta_logical_monitor_get_number (monitor),
+                      container->monitor_spec ? container->monitor_spec->connector
+                                              : "unknown",
+                      g_list_length (container->workspaces));
 
           container->monitor = monitor;
           for (GList *wl = container->workspaces; wl; wl = wl->next)
@@ -607,12 +630,16 @@ meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager
       else
         {
           meta_topic (META_DEBUG_WORKSPACES,
-                      "Creating %d workspaces for new monitor %d",
+                      "Creating %d workspaces for monitor %d (%s), which has "
+                      "none yet",
                       num_workspaces,
-                      meta_logical_monitor_get_number (monitor));
+                      meta_logical_monitor_get_number (monitor),
+                      monitor_spec ? monitor_spec->connector : "unknown");
 
           container = g_new0 (MetaWorkspaceContainer, 1);
           container->monitor = monitor;
+          container->monitor_spec =
+            monitor_spec ? meta_monitor_spec_clone (monitor_spec) : NULL;
           created_workspaces = TRUE;
           for (i = 0; i < num_workspaces; i++)
             {
