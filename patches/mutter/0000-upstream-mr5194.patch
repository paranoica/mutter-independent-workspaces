index 45b860eb8e6..afb5bc72398 100644
--- a/src/core/display.c
+++ b/src/core/display.c
@@ -2596,6 +2596,11 @@ static void
 on_monitors_changed_internal (MetaMonitorManager *monitor_manager,
                               MetaDisplay        *display)
 {
+  /* Before anything looks at the new monitors, in particular the windows
+   * below, so that they find the workspaces of the monitor they end up on.
+   */
+  meta_workspace_manager_monitors_changed (display->workspace_manager);
+
   meta_workspace_manager_reload_work_areas (display->workspace_manager);
 
   /* Fix up monitor for all windows on this display */
diff --git a/src/core/meta-workspace-manager-private.h b/src/core/meta-workspace-manager-private.h
index d2591f24c75..51140d35b3c 100644
--- a/src/core/meta-workspace-manager-private.h
+++ b/src/core/meta-workspace-manager-private.h
@@ -118,6 +118,10 @@ GList * meta_workspace_manager_get_active_workspaces (MetaWorkspaceManager *work
 void meta_workspace_manager_remove_from_container (MetaWorkspaceManager *workspace_manager,
                                                    MetaWorkspace        *workspace);
 
+/* Rebuild the per-monitor containers after the monitors changed. Has to run
+   before anything reacts to the new monitors, windows in particular. */
+void meta_workspace_manager_monitors_changed (MetaWorkspaceManager *workspace_manager);
+
 void meta_workspace_manager_workspace_switched (MetaWorkspaceManager *workspace_manager,
                                                 int                   from,
                                                 int                   to,
diff --git a/src/core/meta-workspace-manager.c b/src/core/meta-workspace-manager.c
index e4734d4141f..9810d182d6c 100644
--- a/src/core/meta-workspace-manager.c
+++ b/src/core/meta-workspace-manager.c
@@ -41,8 +41,6 @@ G_DEFINE_TYPE (MetaWorkspaceManager, meta_workspace_manager, G_TYPE_OBJECT)
 
 /* Forward declarations */
 static void meta_workspace_manager_setup_per_monitor_workspaces (MetaWorkspaceManager *workspace_manager);
-static void on_monitors_changed (MetaMonitorManager   *monitor_manager,
-                                 MetaWorkspaceManager *workspace_manager);
 
 enum
 {
@@ -320,20 +318,12 @@ meta_workspace_manager_new (MetaDisplay *display)
 
   if (workspace_manager->per_monitor_workspaces)
     {
-      MetaContext *context = meta_display_get_context (display);
-      MetaBackend *backend = meta_context_get_backend (context);
-      MetaMonitorManager *monitor_manager = meta_backend_get_monitor_manager (backend);
-
       workspace_manager->workspace_containers =
         g_hash_table_new_full (g_direct_hash,
                                g_direct_equal,
                                NULL,
                                free_workspace_container);
 
-      /* Connect to monitors-changed signal to setup workspaces when monitors are configured */
-      g_signal_connect (monitor_manager, "monitors-changed",
-                        G_CALLBACK (on_monitors_changed),
-                        workspace_manager);
     }
 
   /* This is the default layout extracted from default
@@ -523,17 +513,20 @@ meta_workspace_manager_setup_per_monitor_workspaces (MetaWorkspaceManager *works
 }
 
 /**
