+/**
+ * meta_workspace_manager_remove_from_monitor_state:
+ * @workspace_manager: a #MetaWorkspaceManager
+ * @workspace: the workspace to remove from per-monitor state
+ *
+ * Removes a workspace from its associated monitor's workspace list.
+ * Called automatically by meta_workspace_remove() to avoid orphaned references.
+ * Updates monitor_index for remaining workspaces and handles active workspace
+ * removal.
+ */
+void
+meta_workspace_manager_remove_from_monitor_state (MetaWorkspaceManager *workspace_manager,
+                                                  MetaWorkspace        *workspace)
+{
+  MetaLogicalMonitor *monitor;
+  MetaMonitorWorkspaceState *state;
+  GList *l;
+  int idx;
+
+  if (!workspace_manager->monitor_workspace_states)
+    return;
+
+  monitor = workspace->monitor;
+  if (!monitor)
+    {
+      /* Workspace not associated with a monitor - search all states */
+      GHashTableIter iter;
+      gpointer key, value;
+
+      g_hash_table_iter_init (&iter, workspace_manager->monitor_workspace_states);
+      while (g_hash_table_iter_next (&iter, &key, &value))
+        {
+          state = value;
+          if (g_list_find (state->workspaces, workspace))
+            {
+              monitor = key;
+              break;
+            }
+        }
+    }
+
+  if (!monitor)
+    return;
+
+  state = g_hash_table_lookup (workspace_manager->monitor_workspace_states, monitor);
+  if (!state)
+    return;
+
+  meta_topic (META_DEBUG_WORKSPACES,
+              "Removing workspace (monitor_index=%d, global_index=%d) from monitor state",
+              workspace->monitor_index, meta_workspace_index (workspace));
+
+  state->workspaces = g_list_remove (state->workspaces, workspace);
+
+  /* Renumber remaining workspaces on this monitor */
+  for (l = state->workspaces, idx = 0; l; l = l->next, idx++)
+    ((MetaWorkspace *)l->data)->monitor_index = idx;
+
+  /* Handle if we removed the active workspace on this monitor */
+  if (state->active_workspace == workspace)
+    {
+      if (state->workspaces)
+        state->active_workspace = state->workspaces->data;
+      else
+        state->active_workspace = NULL;
+
+      meta_topic (META_DEBUG_WORKSPACES,
+                  "Active workspace on monitor removed, new active: %p",
+                  state->active_workspace);
+    }
+}
