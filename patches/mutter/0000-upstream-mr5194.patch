 src/x11/meta-x11-display.c                   | 4 ++--
 src/x11/window-x11.c                         | 2 +-
 3 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/wayland/meta-wayland-xdg-session-state.c b/src/wayland/meta-wayland-xdg-session-state.c
index d505e755059..54651b63a97 100644
--- a/src/wayland/meta-wayland-xdg-session-state.c
+++ b/src/wayland/meta-wayland-xdg-session-state.c
@@ -365,7 +365,7 @@ meta_wayland_xdg_session_state_save_window (MetaSessionState *state,
       toplevel_state->floating.rect = rect;
     }
 
-  toplevel_state->workspace_idx = meta_workspace_index (window->workspace);
+  toplevel_state->workspace_idx = meta_workspace_get_global_index (window->workspace);
 
   if (meta_is_topic_enabled (META_DEBUG_SESSION_MANAGEMENT))
     {
diff --git a/src/x11/meta-x11-display.c b/src/x11/meta-x11-display.c
index caf29b8fbbd..9fd453709c4 100644
--- a/src/x11/meta-x11-display.c
+++ b/src/x11/meta-x11-display.c
@@ -852,7 +852,7 @@ set_active_workspace_hint (MetaWorkspaceManager *workspace_manager,
   if (x11_display->display->closing > 0)
     return;
 
-  data[0] = meta_workspace_index (workspace_manager->active_workspace);
+  data[0] = meta_workspace_get_global_index (workspace_manager->active_workspace);
 
   meta_topic (META_DEBUG_X11, "Setting _NET_CURRENT_DESKTOP to %lu", data[0]);
 
@@ -992,7 +992,7 @@ set_workspace_work_area_hint (MetaWorkspace  *workspace,
     }
 
   workarea_name = g_strdup_printf ("_GTK_WORKAREAS_D%d",
-                                   meta_workspace_index (workspace));
+                                   meta_workspace_get_global_index (workspace));
 
   workarea_atom = XInternAtom (x11_display->xdisplay, workarea_name, False);
 
diff --git a/src/x11/window-x11.c b/src/x11/window-x11.c
index d63336960d7..7eb8dd09265 100644
--- a/src/x11/window-x11.c
+++ b/src/x11/window-x11.c
@@ -1234,7 +1234,7 @@ meta_window_get_net_wm_desktop (MetaWindow *window)
   if (window->on_all_workspaces)
     return 0xFFFFFFFF;
   else
-    return meta_workspace_index (window->workspace);
+    return meta_workspace_get_global_index (window->workspace);
 }
 
