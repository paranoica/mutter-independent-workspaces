-            return; // Will trigger another check
+        while (emptyWorkspaces.length < MIN_NUM_WORKSPACES) {
+            workspaceManager.append_new_workspace_for_monitor(monitorIndex, false, time);
+            emptyWorkspaces.push(true);
         }
 
-        // Get active workspace for this monitor
-        const activeWs = workspaceManager.get_active_workspace_for_monitor(monitorIndex);
-        const activeIndex = workspacesOnMonitor.indexOf(activeWs);
+        const activeWorkspace = workspaceManager.get_active_workspace_for_monitor(monitorIndex);
+        const activeIndex = workspaces.indexOf(activeWorkspace);
         if (activeIndex >= 0)
             emptyWorkspaces[activeIndex] = false;
 
         const lastEmptyIndex = emptyWorkspaces.lastIndexOf(false) + 1;
+        let nWorkspaces = emptyWorkspaces.length;
 
-        // Remove empty workspaces in the middle (keep last one)
-        // Go from end to avoid index changes
-        for (let i = lastIndex - 1; i >= 0; i--) {
-            if (workspacesOnMonitor.length <= MIN_NUM_WORKSPACES)
+        for (let i = workspaces.length - 1; i >= 0; i--) {
+            if (nWorkspaces === MIN_NUM_WORKSPACES)
                 break;
             if (emptyWorkspaces[i] && i !== lastEmptyIndex) {
-                const workspace = workspacesOnMonitor[i];
-
-                // Don't remove active workspace
-                if (workspace === activeWs)
-                    continue;
-
-                workspaceManager.remove_workspace(workspace, global.get_current_time());
-                return; // Removed a workspace, will trigger another check
+                workspaceManager.remove_workspace(workspaces[i], time);
+                nWorkspaces--;
             }
         }
     }
 
-    _workspaceHasContentOnMonitor(workspace, monitorIndex) {
-        // Check windows on this workspace for this specific monitor
-        const windows = workspace.list_windows();
-
-        for (const window of windows) {
-            // Skip sticky windows - they don't count as content for any specific workspace
-            if (window.is_on_all_workspaces())
