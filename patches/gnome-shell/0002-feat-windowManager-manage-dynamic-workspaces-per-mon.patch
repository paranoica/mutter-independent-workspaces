-        if (!workspacesOnMonitor || workspacesOnMonitor.length === 0) {
-            console.warn(`WorkspaceTracker: No workspaces for monitor ${monitorIndex}`);
-            return;  // No workspaces on this monitor yet
-        }
-
-        console.log(`WorkspaceTracker: Monitor ${monitorIndex} has ${workspacesOnMonitor.length} workspaces`);
-
-        const emptyWorkspaces = [];
-
-        // Mark workspaces as non-empty if they have content
-        for (let i = 0; i < workspacesOnMonitor.length; i++) {
-            const workspace = workspacesOnMonitor[i];
-
-            if (this._workspaceHasContentOnMonitor(workspace, monitorIndex))
-                emptyWorkspaces[i] = false;
