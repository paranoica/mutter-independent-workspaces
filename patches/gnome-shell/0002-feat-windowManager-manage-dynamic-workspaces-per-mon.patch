-
-            // Does this window belong to our monitor?
-            if (window.get_monitor() === monitorIndex)
-                return true;
-        }
+    _workspaceHasContent(workspace) {
+        if (workspace.list_windows().some(w => !w.is_on_all_workspaces()))
+            return true;
 
-        // Check for startup sequences - these reserve workspace space
-        // Note: Startup sequences aren't monitor-specific in current mutter API,
-        // so we check them globally and assume they apply to primary monitor
-        if (monitorIndex === Main.layoutManager.primaryIndex) {
-            const sequences = Shell.WindowTracker.get_default().get_startup_sequences();
-            for (let i = 0; i < sequences.length; i++) {
-                const index = sequences[i].get_workspace();
-                if (index === workspace.get_global_index())
-                    return true;
-            }
-        }
+        const sequences = Shell.WindowTracker.get_default().get_startup_sequences();
+        if (sequences.some(s => s.get_workspace() === workspace.get_global_index()))
