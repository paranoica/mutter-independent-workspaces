From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paranoica <mitjumper@gmail.com>
Date: Tue, 24 Nov 2026 10:46:09 +0300
Subject: [PATCH 2/3] feat(windowManager): manage dynamic workspaces per
 monitor

Keeps one empty workspace at the end of every monitor and removes the other empty ones, using the per-monitor workspace manager API. Any window on a workspace counts, so a window being dragged to another monitor does not make its workspace look empty, and windows entering or leaving any monitor trigger a check. Drops the debug logging that ran on every check.
---
 js/ui/windowManager.js | 145 ++++++++++-------------------------------
 1 file changed, 35 insertions(+), 110 deletions(-)

diff --git a/js/ui/windowManager.js b/js/ui/windowManager.js
index 4d64337..b4fd82e 100644
--- a/js/ui/windowManager.js
+++ b/js/ui/windowManager.js
@@ -229,16 +229,10 @@ class WorkspaceTracker {
         if (this._pauseWorkspaceCheck)
             return GLib.SOURCE_CONTINUE;
 
-        const perMonitorWorkspaces = this._workspaceSettings.get_boolean('per-monitor-workspaces');
-        console.log(`WorkspaceTracker: per-monitor-workspaces=${perMonitorWorkspaces}`);
-
-        if (perMonitorWorkspaces) {
-            // Per-monitor mode: check each monitor independently
+        if (global.workspace_manager.per_monitor_workspaces)
             this._checkWorkspacesPerMonitor();
-        } else {
-            // Classic global mode: check workspaces globally
+        else
             this._checkWorkspacesGlobal();
-        }
 
         this._checkWorkspacesId = 0;
         return GLib.SOURCE_REMOVE;
@@ -308,19 +302,7 @@ class WorkspaceTracker {
     }
 
     _checkWorkspacesPerMonitor() {
-        const workspaceManager = global.workspace_manager;
-
-        // Safety check: ensure per-monitor APIs are available
-        if (typeof workspaceManager.get_workspaces_for_monitor !== 'function') {
-            console.warn('Per-monitor workspace APIs not available, falling back to global mode');
-            this._checkWorkspacesGlobal();
-            return;
-        }
-        console.log('WorkspaceTracker: checking per-monitor workspaces');
-
-        // Check each monitor independently
         const monitors = Main.layoutManager.monitors;
-        console.log(`WorkspaceTracker: ${monitors.length} monitors detected`);
 
         for (let monitorIndex = 0; monitorIndex < monitors.length; monitorIndex++)
             this._checkWorkspacesForMonitor(monitorIndex);
@@ -328,117 +310,58 @@ class WorkspaceTracker {
 
