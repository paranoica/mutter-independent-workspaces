         }
 
-        // Ensure minimum 2 workspaces per monitor
-        if (workspacesOnMonitor.length < MIN_NUM_WORKSPACES) {
-            workspaceManager.append_new_workspace_for_monitor(
-                monitorIndex, false, global.get_current_time()
