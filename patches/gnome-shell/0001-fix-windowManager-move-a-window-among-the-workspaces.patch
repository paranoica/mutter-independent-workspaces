From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: paranoica <mitjumper@gmail.com>
Date: Tue, 24 Nov 2026 10:46:09 +0300
Subject: [PATCH 1/3] fix(windowManager): move a window among the workspaces of
 its own monitor

The move-to-workspace bindings picked the target from the monitor under the pointer. With the focused window on another monitor it ended up on a workspace of that monitor and showed through whenever that workspace was active.
---
 js/ui/windowManager.js | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/js/ui/windowManager.js b/js/ui/windowManager.js
index 34b5d2b..4d64337 100644
--- a/js/ui/windowManager.js
+++ b/js/ui/windowManager.js
@@ -1985,13 +1985,15 @@ export class WindowManager {
         if (!Main.sessionMode.hasWorkspaces)
             return;
 
-        const currentMonitor = this._getCurrentMonitorForWorkspaceSwitch();
+        let [action,,, target] = binding.get_name().split('-');
+        const currentMonitor = action === 'move' && window && this._isPerMonitorMode()
+            ? window.get_monitor()
+            : this._getCurrentMonitorForWorkspaceSwitch();
         const workspaces = this._getWorkspacesForSwitch(currentMonitor);
 
         if (workspaces.length === 1)
             return;
 
-        let [action,,, target] = binding.get_name().split('-');
         let newWs;
         let direction;
         const vertical = workspaceManager.layout_rows === -1;
